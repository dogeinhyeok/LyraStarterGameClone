{
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.formatting": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "unreal-clangd.creation.overwrite": "partial",
    "unreal-clangd.utility.createProjectOnStartup": false,
    "C_Cpp.intelliSenseEngine": "disabled",
    "unreal-clangd.creation.compilerPath": "c:\\Program Files\\LLVM\\bin\\clang-cl.exe",
    "clangd.path": "c:\\Program Files\\LLVM\\bin\\clangd.exe",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.inlayHints.enabled": "off",
    "unreal-clangd.systemIncludes.showMissingWarning": false,
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[h]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[hpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[csharp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.defaultFormatter": "csharpier.csharpier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[mdc]": {
        "editor.defaultFormatter": "unifiedjs.vscode-mdx"
    },
    "files.exclude": {
        "**/Binaries": true,
        "**/Intermediate": true,
        "**/DerivedDataCache": true,
        "**/Saved": true,
        "**/.vs": true,
        "**/Packages": true,
        "Plugins/**/Intermediate": true,
        "Plugins/**/Binaries": true,
        "Plugins/**/Saved": true,
        "Plugins/**/DerivedDataCache": true
    },
    "search.exclude": {
        "**/Binaries": true,
        "**/Intermediate": true,
        "**/DerivedDataCache": true,
        "**/Saved": true,
        "**/.vs": true,
        "**/Packages": true,
        "**/ThirdParty": true,
        "Plugins/**/Intermediate": true,
        "Plugins/**/Binaries": true,
        "Plugins/**/Saved": true,
        "Plugins/**/DerivedDataCache": true
    },
    "C_Cpp.files.exclude": {
        "**/Binaries/**": true,
        "**/Intermediate/**": true,
        "**/DerivedDataCache/**": true,
        "**/Saved/**": true,
        "**/.vs/**": true,
        "**/*.generated.h": true,
        "**/*.gen.cpp": true,
        "Plugins/**/Intermediate/**": true,
        "Plugins/**/Binaries/**": true,
        "Plugins/**/Saved/**": true,
        "Plugins/**/DerivedDataCache/**": true
    },
}