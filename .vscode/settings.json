{
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.formatting": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "unreal-clangd.creation.overwrite": "partial",
    "unreal-clangd.utility.createProjectOnStartup": false,
    "C_Cpp.intelliSenseEngine": "disabled",
    "unreal-clangd.creation.compilerPath": "c:\\Program Files\\LLVM\\bin\\clang-cl.exe",
    "clangd.path": "c:\\Program Files\\LLVM\\bin\\clangd.exe",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.inlayHints.enabled": "off",
    "unreal-clangd.systemIncludes.showMissingWarning": false,
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[h]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[hpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[mdc]": {
        "editor.defaultFormatter": "unifiedjs.vscode-mdx"
    },
    // .cursorignore 설정을 files.exclude로 매핑
    "files.exclude": {
        // 빌드/캐시/임시/IDE 파일
        "Binaries/": true,
        "DerivedDataCache/": true,
        "Intermediate/": true,
        "Saved/": true,
        "Build/": true,
        ".ignore": true,
        // VSCode/IDE/환경설정 파일
        ".idea/": true,
        "*.sln": true,
        "*.suo": true,
        "*.xcodeproj": true,
        "*.xcworkspace": true,
        "*.opensdf": true,
        "*.sdf": true,
        "*.VC.db": true,
        "*.VC.opendb": true,
        "*.log": true,
        "*.tlog": true,
        "*.ipch": true,
        "*.aps": true,
        "*.ncb": true,
        "*.user": true,
        "*.userprefs": true,
        "*.dbmdl": true,
        "*.cache": true,
        "*.pdb": true,
        "*.obj": true,
        "*.exe": true,
        "*.dll": true,
        "*.app": true,
        "*.dylib": true,
        "*.icns": true,
        "*.ipa": true,
        "*.lib": true,
        "*.a": true,
        "*.exp": true,
        "*.vs/": true,
        "*.DS_Store": true,
        "Thumbs.db": true,
        "ehthumbs.db": true,
        // 플러그인 빌드/임시 폴더
        "**/Plugins/*/Intermediate/": true,
        "**/Plugins/*/Binaries/": true,
        "**/Plugins/*/*/Intermediate/": true,
        "**/Plugins/*/*/Binaries/": true,
        // Obsidian 파일들
        ".trash/": true,
        ".obsidian/workspace.json": true,
        ".smart-env/": true,
        ".smtcmp_json_db/": true,
        ".smtcmp_vector_db.tar.gz": true,
        "copilot-index-*.json": true,
        // 패키지 잠금 파일들
        "package-lock.json": true,
        "pnpm-lock.yaml": true,
        "yarn.lock": true,
        "composer.lock": true,
        "Gemfile.lock": true,
        "bun.lockb": true,
        ".env*": true,
        // 버전 관리 시스템
        ".git/": true,
        ".svn/": true,
        ".hg/": true,
        // 일반 무시 파일들
        "*.lock": true,
        "*.bak": true,
        "*.tmp": true,
        "*.bin": true,
        "*.so": true,
        "*.lockb": true,
        "*.qwoff": true,
        "*.isl": true,
        // 문서/미디어 파일들
        "*.csv": true,
        "*.pdf": true,
        "*.doc": true,
        "*.xls": true,
        "*.xlsx": true,
        "*.ppt": true,
        "*.pptx": true,
        "*.odt": true,
        "*.ods": true,
        "*.odp": true,
        "*.odg": true,
        "*.odf": true,
        "*.sxw": true,
        "*.sxc": true,
        "*.sxi": true,
        "*.sxd": true,
        "*.sdc": true,
        // 이미지 파일들
        "*.jpg": true,
        "*.jpeg": true,
        "*.png": true,
        "*.gif": true,
        "*.bmp": true,
        "*.tif": true,
        "*.webp": true,
        "*.svg": true,
        // 오디오 파일들
        "*.mp3": true,
        "*.wav": true,
        "*.wma": true,
        "*.ogg": true,
        "*.flac": true,
        "*.aac": true,
        // 비디오 파일들
        "*.mp4": true,
        "*.mov": true,
        "*.wmv": true,
        "*.flv": true,
        "*.avi": true,
        // 압축 파일들
        "*.zip": true,
        "*.tar": true,
        "*.gz": true,
        "*.7z": true,
        "*.rar": true,
        "*.tgz": true,
        "*.dmg": true,
        "*.iso": true,
        "*.cue": true,
        "*.mdf": true,
        "*.mds": true,
        "*.vcd": true,
        "*.toast": true,
        "*.img": true,
        "*.apk": true,
        "*.msi": true,
        "*.cab": true,
        "*.tar.gz": true,
        "*.tar.xz": true,
        "*.tar.bz2": true,
        "*.tar.lzma": true,
        "*.tar.Z": true,
        "*.tar.sz": true,
        "*.lzma": true,
        // 폰트 파일들
        "*.ttf": true,
        "*.otf": true,
        "*.woff": true,
        "*.woff2": true,
        "*.eot": true,
        // 기타 파일들
        "*.pak": true,
        "*.vsix": true,
        "*.rmeta": true,
        "*.rlib": true,
        "*.parquet": true,
        // 개발 환경 폴더들
        ".egg-info/": true,
        ".venv/": true,
        "node_modules/": true,
        "__pycache__/": true,
        ".next/": true,
        ".nuxt/": true,
        ".cache/": true,
        ".sass-cache/": true,
        ".gradle/": true,
        ".DS_Store/": true,
        ".ipynb_checkpoints/": true,
        ".pytest_cache/": true,
        ".mypy_cache/": true,
        ".tox/": true,
        ".bzr/": true,
        ".lock-wscript/": true,
        ".Python/": true,
        ".jupyter/": true,
        ".history/": true,
        ".yarn/": true,
        ".yarn-cache/": true,
        ".eslintcache/": true,
        ".parcel-cache/": true,
        ".cache-loader/": true,
        ".nyc_output/": true,
        ".node_repl_history/": true,
        ".pnp.js/": true,
        ".pnp/": true
    },
}